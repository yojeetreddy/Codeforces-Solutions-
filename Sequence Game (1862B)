mport sys

input = sys.stdin.read

data = input().split()

index = 0

t = int(data[index]) # Number of test cases
index += 1

for _ in range(t):
	n = int(data[index]) # Length of sequence b
	index += 1
	b = list(map(int, data[index:index + n])) # Read the sequence b
	index += n

	a = [b[0]] # Always add the first element of b to a
	for i in range(1, n):
		if b[i] >= b[i - 1]:
			a.append(b[i]) # If current element is greater than or equal to the previous, add it to a
		else:
			a.append(b[i]) # Add the current element to a
			a.append(b[i]) # Add the current element again to a to ensure a[i-1] <= a[i]

	print(len(a)) # Output the size of the reconstructed sequence a
	print(' '.join(map(str, a))) # Output each element of the sequence a
