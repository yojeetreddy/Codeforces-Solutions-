import sys
from collections import Counter
 
input = sys.stdin.read
data = input().split()
 
index = 0
t = int(data[index])
index += 1
 
for _ in range(t):
    n = int(data[index])
    index += 1
 
    a = list(map(int, data[index:index+n]))
    index += n
 
    freq_map = Counter(a)
 
    if len(freq_map) >= 3:
        print("NO")
    else:
        freq_1 = next(iter(freq_map.values()))
        freq_2 = list(freq_map.values())[-1]
 
        if freq_1 == freq_2:
            print("YES")
        elif n % 2 != 0 and abs(freq_1 - freq_2) == 1:
            print("YES")
        else:
            print("NO")
